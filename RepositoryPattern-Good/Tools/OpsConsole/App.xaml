<Application x:Class="WebShop.Tools.OpsConsole.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WebShop.Tools.OpsConsole.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
    </Application.Resources>
</Application>
