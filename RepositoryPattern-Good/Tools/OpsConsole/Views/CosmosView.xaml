<UserControl x:Class="WebShop.Tools.OpsConsole.Views.CosmosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="12" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
        <TextBlock Text="Cosmos DB" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"
                   Text="Create provisions infra/cosmos.bicep's account + two containers. Restore imports an NDJSON dump folder (produced earlier by Tools/CosmosMigration --export) via that same tool. Delete removes the account entirely." />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Resource group" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" IsEditable="True" IsTextSearchEnabled="True"
                      ItemsSource="{Binding ResourceGroups}" Text="{Binding ResourceGroup, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Location" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                      ItemsSource="{Binding EuropeanRegions}" DisplayMemberPath="DisplayName" SelectedValuePath="Name"
                      SelectedValue="{Binding Location}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Account name" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
        </Grid>

        <Button Content="Create" Width="140" HorizontalAlignment="Left" Margin="0,4" Padding="0,4"
                Command="{Binding CreateCommand}" />

        <Separator Margin="0,8" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Dump folder" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DumpFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,4,2" />
            <Button Grid.Column="2" Content="Browse..." Padding="8,0" Command="{Binding BrowseDumpFolderCommand}" />
        </Grid>
        <Button Content="Restore" Width="140" HorizontalAlignment="Left" Margin="0,4" Padding="0,4"
                Command="{Binding RestoreCommand}" />

        <Separator Margin="0,8" />

        <Button Content="Delete" Width="140" HorizontalAlignment="Left" Margin="0,4" Padding="0,4"
                Foreground="DarkRed" Command="{Binding DeleteCommand}" />

        <TextBlock Text="Working..." FontStyle="Italic" Margin="0,12,0,0"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
