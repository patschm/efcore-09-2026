<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Cosmos\WebShop.BuildingBlocks.Cosmos.csproj" />
    <!-- Document DTOs only (Brand/ProductGroup, Shop, ReviewUser/Review, Product/SpecValue) - this
         project talks to Cosmos directly, the same way Tools/CosmosMigration does, rather than
         through each context's aggregate-shaped repository interfaces (which aren't a good fit
         for "patch a denormalized field across N documents" fan-out queries). -->
    <ProjectReference Include="..\..\Catalog\Infrastructure\Cosmos\WebShop.Catalog.Infrastructure.Cosmos.csproj" />
    <ProjectReference Include="..\..\Pricing\Infrastructure\Cosmos\WebShop.Pricing.Infrastructure.Cosmos.csproj" />
    <ProjectReference Include="..\..\Reviews\Infrastructure\Cosmos\WebShop.Reviews.Infrastructure.Cosmos.csproj" />
    <!-- The one exception: re-embedding reuses Search's real Application pipeline
         (UpsertProductEmbeddingCommandHandler -> IEmbeddingClient -> IProductEmbeddingRepository)
         verbatim, instead of re-deriving embedding-write logic here. -->
    <ProjectReference Include="..\..\Search\Application\WebShop.Search.Application.csproj" />
    <ProjectReference Include="..\..\Search\Infrastructure\Cosmos\WebShop.Search.Infrastructure.Cosmos.csproj" />
    <ProjectReference Include="..\..\Search\Infrastructure\Embedding\WebShop.Search.Infrastructure.Embedding.csproj" />
  </ItemGroup>

</Project>
