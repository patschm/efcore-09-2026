<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Which persistence provider Program.cs compiles against - see Directory.Build.props for the
       WebShopProvider switch and how to override it. DefineConstants drives the #if in Program.cs;
       the ItemGroups below drive which Infrastructure project (and its EF packages, where needed)
       actually gets built and shipped - #if alone can't remove an unreferenced ProjectReference's
       assembly from the output, that's a build-graph concern, not a source-code one. -->
  <PropertyGroup>
    <DefineConstants Condition="'$(WebShopProvider)' == 'Cosmos'">$(DefineConstants);COSMOS</DefineConstants>
    <DefineConstants Condition="'$(WebShopProvider)' == 'Postgres'">$(DefineConstants);POSTGRES</DefineConstants>
    <DefineConstants Condition="'$(WebShopProvider)' == 'SqlServer'">$(DefineConstants);SQLSERVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\WebShop.Catalog.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Api\WebShop.BuildingBlocks.Api.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(WebShopProvider)' == 'Cosmos'">
    <ProjectReference Include="..\Infrastructure\Cosmos\WebShop.Catalog.Infrastructure.Cosmos.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(WebShopProvider)' == 'Postgres'">
    <ProjectReference Include="..\Infrastructure\Postgres\WebShop.Catalog.Infrastructure.Postgres.csproj" />
    <!-- Forces the same patch version Npgsql pulls in transitively. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(WebShopProvider)' == 'SqlServer'">
    <ProjectReference Include="..\Infrastructure\SqlServer\WebShop.Catalog.Infrastructure.SqlServer.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

</Project>
