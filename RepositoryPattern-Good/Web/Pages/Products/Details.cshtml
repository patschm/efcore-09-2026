@page "/products/{id:int}"
@model WebShop.Web.Pages.Products.DetailsModel
@{
    ViewData["Title"] = Model.Product.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">ACME</a></li>
        @foreach (var ancestor in Model.Ancestors)
        {
            <li class="breadcrumb-item"><a asp-page="/ProductGroups/Details" asp-route-id="@ancestor.Id">@ancestor.Name</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Model.Product.Name</li>
    </ol>
</nav>

<h1 class="mb-4">@Model.Product.BrandName @Model.Product.Name</h1>

<ul class="nav nav-tabs" id="productTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="specifications-tab" data-bs-toggle="tab" data-bs-target="#specifications" type="button" role="tab">
            Specifications
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="prices-tab" data-bs-toggle="tab" data-bs-target="#prices" type="button" role="tab">
            Prices (@Model.Prices.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">
            Reviews (@Model.Reviews.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="similar-tab" data-bs-toggle="tab" data-bs-target="#similar" type="button" role="tab">
            Similar products (@Model.SimilarProducts.Count)
        </button>
    </li>
</ul>

<div class="tab-content border border-top-0 p-3" id="productTabsContent">
    <div class="tab-pane fade show active" id="specifications" role="tabpanel">
        @if (Model.Product.Specifications.Count == 0)
        {
            <p class="text-muted">No specifications recorded.</p>
        }
        else
        {
            var specHalf = (Model.Product.Specifications.Count + 1) / 2;
            var leftSpecs = Model.Product.Specifications.Take(specHalf).ToList();
            var rightSpecs = Model.Product.Specifications.Skip(specHalf).ToList();

            <div class="row">
                <div class="col-md-6">
                    <table class="table table-sm spec-table mb-0">
                        <tbody>
                            @foreach (var spec in leftSpecs)
                            {
                                @await Html.PartialAsync("_SpecificationRow", spec)
                            }
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6 spec-column-right">
                    <table class="table table-sm spec-table mb-0">
                        <tbody>
                            @foreach (var spec in rightSpecs)
                            {
                                @await Html.PartialAsync("_SpecificationRow", spec)
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
    <div class="tab-pane fade" id="prices" role="tabpanel">
        @if (Model.Prices.Count == 0)
        {
            <p class="text-muted">No prices available.</p>
        }
        else
        {
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Shop</th>
                        <th>Base price</th>
                        <th>Shipping</th>
                        <th>In stock</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var price in Model.Prices)
                    {
                        var filledStars = (int)Math.Round(price.ShopRating);
                        // ShippingPriceAmount is actually the delivered total (base + shipping),
                        // not the shipping fee alone - subtract the base price to get the fee.
                        var shippingCost = price.ShippingPriceAmount - price.ShopPriceAmount;
                        <tr>
                            <td>
                                <div>@price.ShopName</div>
                                <div>
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        @if (i <= filledStars)
                                        {
                                            <span class="text-warning">&#9733;</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&#9734;</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td>@price.ShopPriceAmount.ToString("0.00") @price.ShopPriceCurrency</td>
                            <td>@shippingCost.ToString("0.00") @price.ShippingPriceCurrency</td>
                            <td>@price.InStock</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="tab-pane fade" id="reviews" role="tabpanel">
        <div class="d-flex justify-content-end mb-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addReviewModal">Write a review</button>
            }
            else
            {
                <a asp-page="/Account/Login" asp-route-returnUrl="@Url.Page(pageName: "/Products/Details", pageHandler: null, values: new { id = Model.Product.Id }, protocol: null, host: null, fragment: "reviews")" class="btn btn-primary">
                    Log in to write a review
                </a>
            }
        </div>
        @if (Model.Reviews.Count == 0)
        {
            <p class="text-muted">No reviews yet.</p>
        }
        else
        {
            @foreach (var review in Model.Reviews)
            {
                <div class="mb-3 pb-3 border-bottom">
                    <div class="d-flex justify-content-between">
                        <strong>@(review.Title ?? review.Type)</strong>
                        @if (review.Score is not null)
                        {
                            // Scores are stored on a 0-10 scale; halve to express as 0-5 stars.
                            var filledStars = (int)Math.Round(review.Score.Value / 2);
                            <div>
                                @for (var i = 1; i <= 5; i++)
                                {
                                    @if (i <= filledStars)
                                    {
                                        <span class="text-warning">&#9733;</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&#9734;</span>
                                    }
                                }
                            </div>
                        }
                    </div>
                    <p class="mb-1">@review.Text</p>
                    <small class="text-muted">By @(review.ReviewerName ?? "Anonymous") on @review.CreationDate.ToString("d")</small>
                </div>
            }
        }
    </div>
    <div class="tab-pane fade" id="similar" role="tabpanel">
        @if (Model.SimilarProducts.Count == 0)
        {
            <p class="text-muted">No similar products found.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var similar in Model.SimilarProducts)
                {
                    <a asp-page="/Products/Details" asp-route-id="@similar.ProductId" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        <img src="@(similar.ImageUrl ?? "/images/no-image-available.jpg")" alt="@similar.Name" class="rounded" style="width: 64px; height: 64px; object-fit: cover;">
                        <div class="flex-grow-1">
                            <div>@similar.BrandName @similar.Name</div>
                            <div class="text-muted small">Similarity: @((int)Math.Round(similar.Score * 100))%</div>
                        </div>
                        <div class="text-end">
                            @if (similar.LowestPriceAmount is { } amount)
                            {
                                <div>From @amount.ToString("0.00") @similar.LowestPriceCurrency</div>
                            }
                            else
                            {
                                <div class="text-muted">No price available</div>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="modal fade" id="addReviewModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <form method="post">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Write a review</h5>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="NewReview.Title" class="form-label">Title</label>
                            <input asp-for="NewReview.Title" class="form-control">
                            <span asp-validation-for="NewReview.Title" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewReview.Score" class="form-label">Score (1-10)</label>
                            <input asp-for="NewReview.Score" type="number" min="1" max="10" class="form-control">
                            <span asp-validation-for="NewReview.Score" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewReview.StrongPoints" class="form-label">Sterke punten</label>
                            <textarea asp-for="NewReview.StrongPoints" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewReview.WeakPoints" class="form-label">Zwakke punten</label>
                            <textarea asp-for="NewReview.WeakPoints" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            new bootstrap.Tab(document.querySelector('#reviews-tab')).show();
            new bootstrap.Modal(document.getElementById('addReviewModal')).show();
        });
    </script>
}
else
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.location.hash === '#reviews') {
                new bootstrap.Tab(document.querySelector('#reviews-tab')).show();
            }
        });
    </script>
}
