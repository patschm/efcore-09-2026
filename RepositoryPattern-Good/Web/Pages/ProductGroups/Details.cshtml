@page "/product-groups/{id:int}"
@model WebShop.Web.Pages.ProductGroups.DetailsModel
@{
    ViewData["Title"] = Model.Group.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">ACME</a></li>
        @for (var i = 0; i < Model.Ancestors.Count; i++)
        {
            var ancestor = Model.Ancestors[i];
            @if (i == Model.Ancestors.Count - 1)
            {
                <li class="breadcrumb-item active" aria-current="page">@ancestor.Name</li>
            }
            else
            {
                <li class="breadcrumb-item"><a asp-page="/ProductGroups/Details" asp-route-id="@ancestor.Id">@ancestor.Name</a></li>
            }
        }
    </ol>
</nav>

<h1 class="mb-4">@Model.Group.Name</h1>

@if (Model.ChildGroups.Count > 0)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        @foreach (var group in Model.ChildGroups)
        {
            <div class="col">
                <a asp-page="/ProductGroups/Details" asp-route-id="@group.Id" class="text-decoration-none">
                    <div class="card h-100 shadow-sm">
                        <img src="@(group.ImageUrl ?? "/images/no-image-available.jpg")" class="card-img-top" alt="@group.Name">
                        <div class="card-body">
                            <h5 class="card-title text-dark">@group.Name</h5>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
else if (Model.Products.Count > 0)
{
    <div class="list-group">
        @foreach (var product in Model.Products)
        {
            // Scores are stored on a 0-10 scale; halve to express as 0-5 stars.
            var filledStars = (int)Math.Round(Model.AverageScoresByProductId.GetValueOrDefault(product.Id, 0) / 2);
            <a asp-page="/Products/Details" asp-route-id="@product.Id" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                <img src="@(product.ImageUrl ?? "/images/no-image-available.jpg")" alt="@product.Name" class="rounded" style="width: 64px; height: 64px; object-fit: cover;">
                <div class="flex-grow-1">
                    <div>@product.BrandName @product.Name</div>
                    <div>
                        @for (var i = 1; i <= 5; i++)
                        {
                            @if (i <= filledStars)
                            {
                                <span class="text-warning">&#9733;</span>
                            }
                            else
                            {
                                <span class="text-muted">&#9734;</span>
                            }
                        }
                    </div>
                </div>
            </a>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Product pages" class="mt-3">
            <ul class="pagination">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="/ProductGroups/Details" asp-route-id="@Model.Group.Id" asp-route-pageNumber="@(Model.CurrentPage - 1)">Previous</a>
                </li>
                @foreach (var p in Model.PageNumbersToDisplay)
                {
                    @if (p is null)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    else
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="/ProductGroups/Details" asp-route-id="@Model.Group.Id" asp-route-pageNumber="@p">@p</a>
                        </li>
                    }
                }
                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="/ProductGroups/Details" asp-route-id="@Model.Group.Id" asp-route-pageNumber="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <p class="text-muted">No products in this group yet.</p>
}
