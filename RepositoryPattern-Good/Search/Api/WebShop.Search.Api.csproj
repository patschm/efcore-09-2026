<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Which persistence provider Program.cs compiles against - see Catalog/Api's csproj (and
       Directory.Build.props) for the full explanation of this pattern. -->
  <PropertyGroup>
    <DefineConstants Condition="'$(WebShopProvider)' == 'Cosmos'">$(DefineConstants);COSMOS</DefineConstants>
    <DefineConstants Condition="'$(WebShopProvider)' == 'Postgres'">$(DefineConstants);POSTGRES</DefineConstants>
    <DefineConstants Condition="'$(WebShopProvider)' == 'SqlServer'">$(DefineConstants);SQLSERVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\WebShop.Search.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Embedding\WebShop.Search.Infrastructure.Embedding.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Api\WebShop.BuildingBlocks.Api.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(WebShopProvider)' == 'Cosmos'">
    <ProjectReference Include="..\Infrastructure\Cosmos\WebShop.Search.Infrastructure.Cosmos.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(WebShopProvider)' == 'Postgres'">
    <ProjectReference Include="..\Infrastructure\Postgres\WebShop.Search.Infrastructure.Postgres.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(WebShopProvider)' == 'SqlServer'">
    <ProjectReference Include="..\Infrastructure\SqlServer\WebShop.Search.Infrastructure.SqlServer.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

</Project>
